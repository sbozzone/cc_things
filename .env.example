# ToDone runs fully offline with none of this set. Everything below switches on
# optional server features; the app tells you in Settings which are active.

# --- Accounts and cross-device sync (R32-R34) --------------------------------
# Any Postgres connection string. For a free personal Vercel deployment, create a
# Neon database and paste its pooled connection string here as DATABASE_URL.
# The schema is created automatically on first use.
DATABASE_URL=

# Signs session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# --- Inbound email capture (R29), optional -----------------------------------
# Shared secret your mail provider sends as the `x-inbound-secret` header when it
# POSTs a parsed message to /api/inbound-email. At least 16 characters.
INBOUND_EMAIL_SECRET=

# Domain the per-account capture addresses are issued under, e.g. in.example.com.
# Point that domain's inbound mail (MX or a catch-all) at your provider's parser.
INBOUND_EMAIL_DOMAIN=
